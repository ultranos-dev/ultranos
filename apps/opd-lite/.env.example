NEXT_PUBLIC_HUB_API_URL=http://localhost:3004/api/trpc
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Story 62.2 (M-OPD-3): the Google Cloud Vision key is NO LONGER a client env var.
# KYC OCR is proxied through the Hub (POST /api/ocr/kyc); the credential lives
# server-side as GOOGLE_CLOUD_VISION_API_KEY in apps/hub-api. Do NOT reintroduce
# NEXT_PUBLIC_GOOGLE_CLOUD_VISION_API_KEY — it would ship the key in the bundle.
# CSP_REPORT_URI=https://your-reporting-endpoint.example.com/csp
