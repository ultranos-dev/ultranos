exports[`OutbreakModeBanner — RTL snapshots > LTR: renders banner when outbreak is active (authorized user) 1`] = `
<div>
  <div
    aria-live="assertive"
    data-testid="outbreak-mode-banner"
    role="alert"
    style="position: sticky; top: 0px; z-index: 9000; background-color: rgb(220, 38, 38); color: rgb(255, 255, 255); padding: 0.625rem 1rem; display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; box-shadow: 0 2px 8px rgba(220,38,38,0.4); min-height: 48px;"
  >
    <div
      style="display: flex; align-items: center; gap: 0.625rem; flex: 1 1 0%; flex-wrap: wrap;"
    >
      <span
        data-testid="alert-triangle-icon"
      />
      <span
        style="font-weight: 700; font-size: 0.9375rem;"
      >
        OUTBREAK MODE ACTIVE: 
        MALARIA
      </span>
      <span
        style="font-size: 0.875rem; opacity: 0.9;"
      >
        — Activated by 
        prac-001
         on 
        May 31, 2026
      </span>
    </div>
    <button
      aria-label="Deactivate Outbreak Mode"
      class="hover:bg-white/30 focus-visible:outline focus-visible:outline-2 focus-visible:outline-white"
      style="background-color: rgba(255, 255, 255, 0.2); color: rgb(255, 255, 255); border: 1px solid rgba(255, 255, 255, 0.5); border-radius: 4px; padding: 0.3125rem 0.875rem; cursor: pointer; font-size: 0.875rem; font-weight: 600; white-space: nowrap; flex-shrink: 0;"
      type="button"
    >
      Deactivate
    </button>
  </div>
</div>
`;

