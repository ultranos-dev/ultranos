exports[`SimplifiedResultEntry — RTL snapshots > LTR snapshot 1`] = `
<div>
  <div
    data-testid="simplified-result-entry"
    style="background-color: rgb(255, 255, 255); border: 2px solid rgb(220, 38, 38); border-radius: 8px; padding: 1.5rem; max-width: 480px; width: 100%;"
  >
    <div
      style="display: flex; justify-content: space-between; align-items: center; margin-block-end: 1rem;"
    >
      <div>
        <h3
          style="margin: 0px; font-size: 1.125rem; font-weight: 700;"
        >
          Fast Result Entry
        </h3>
        <p
          style="margin: 0px; color: rgb(107, 114, 128); font-size: 0.875rem;"
        >
          Malaria
           — 
          51587-4
        </p>
      </div>
      <button
        aria-label="Close simplified entry"
        style="background: none; cursor: pointer; font-size: 1.25rem; color: rgb(107, 114, 128);"
        type="button"
      >
        ×
      </button>
    </div>
    <div
      style="margin-block-end: 1.25rem;"
    >
      <label
        for="sample-id-input"
        style="display: block; font-weight: 600; margin-block-end: 0.375rem;"
      >
        Sample ID
      </label>
      <input
        id="sample-id-input"
        placeholder="Scan barcode or type…"
        style="width: 100%; padding: 0.75rem 1rem; font-size: 1.125rem; border-radius: 6px; border: 2px solid rgb(209, 213, 219); box-sizing: border-box;"
        type="text"
        value=""
      />
    </div>
    <div
      style="margin-block-end: 1.25rem;"
    >
      <p
        style="font-weight: 600; margin-block-end: 0.5rem;"
      >
        Result
      </p>
      <div
        style="display: flex; gap: 0.625rem; flex-wrap: wrap;"
      >
        <button
          aria-pressed="false"
          data-testid="result-btn-positive"
          style="flex: 1 1 0%; min-width: 100px; padding: 1rem 0.75rem; font-size: 0.9375rem; font-weight: 700; border-radius: 6px; border: 2px solid rgb(209, 213, 219); background-color: rgb(249, 250, 251); color: rgb(55, 65, 81); cursor: pointer; transition: all 0.1s;"
          type="button"
        >
          POSITIVE
        </button>
        <button
          aria-pressed="false"
          data-testid="result-btn-negative"
          style="flex: 1 1 0%; min-width: 100px; padding: 1rem 0.75rem; font-size: 0.9375rem; font-weight: 700; border-radius: 6px; border: 2px solid rgb(209, 213, 219); background-color: rgb(249, 250, 251); color: rgb(55, 65, 81); cursor: pointer; transition: all 0.1s;"
          type="button"
        >
          NEGATIVE
        </button>
        <button
          aria-pressed="false"
          data-testid="result-btn-indeterminate"
          style="flex: 1 1 0%; min-width: 100px; padding: 1rem 0.75rem; font-size: 0.9375rem; font-weight: 700; border-radius: 6px; border: 2px solid rgb(209, 213, 219); background-color: rgb(249, 250, 251); color: rgb(55, 65, 81); cursor: pointer; transition: all 0.1s;"
          type="button"
        >
          INDETERMINATE
        </button>
      </div>
    </div>
    <div
      style="background-color: rgb(249, 250, 251); border-radius: 6px; padding: 0.75rem; margin-block-end: 1.25rem; font-size: 0.875rem; color: rgb(107, 114, 128);"
    >
      <div>
        Timestamp: 
        <strong>
          6:00:00 AM
        </strong>
         (auto)
      </div>
      <div>
        Tech ID: 
        <strong>
          prac-001
        </strong>
         (session)
      </div>
    </div>
    <button
      disabled=""
      style="width: 100%; padding: 0.875rem; font-size: 1rem; font-weight: 700; border-radius: 6px; background-color: rgb(209, 213, 219); color: rgb(255, 255, 255); cursor: not-allowed;"
      type="button"
    >
      Submit Result
    </button>
  </div>
</div>
`;

