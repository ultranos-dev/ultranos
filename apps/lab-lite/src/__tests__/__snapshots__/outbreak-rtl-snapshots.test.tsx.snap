exports[`ActivateOutbreakModal — RTL snapshots > LTR: form snapshot (authorized user) 1`] = `
<div>
  <div
    aria-label="Activate Outbreak Mode"
    aria-modal="true"
    role="dialog"
    style="position: fixed; inset: 0; z-index: 10000; display: flex; align-items: center; justify-content: center; background-color: rgba(0, 0, 0, 0.5);"
  >
    <div
      style="background-color: rgb(255, 255, 255); border-radius: 8px; padding: 2rem; max-width: 600px; width: 90%; max-height: 90vh; overflow-y: auto;"
    >
      <div
        style="display: flex; align-items: center; gap: 0.75rem; margin-block-end: 1.5rem;"
      >
        <span
          data-testid="alert-triangle-icon"
        />
        <h2
          style="margin: 0px; font-size: 1.25rem; font-weight: 700;"
        >
          Activate Outbreak Mode
        </h2>
      </div>
      <div
        style="margin-block-end: 1rem;"
      >
        <label
          for="pathogen-input"
          style="display: block; font-weight: 600; margin-block-end: 0.375rem;"
        >
          Target Pathogen *
        </label>
        <div
          style="position: relative;"
        >
          <input
            id="pathogen-input"
            placeholder="Search pathogens or enter custom…"
            style="width: 100%; padding: 0.5rem 0.75rem; border-radius: 6px; border: 1px solid rgb(209, 213, 219); font-size: 0.9375rem; box-sizing: border-box;"
            type="text"
            value=""
          />
          <span
            data-testid="chevron-down-icon"
          />
        </div>
      </div>
      <div
        style="margin-block-end: 1rem;"
      >
        <p
          style="font-weight: 600; margin-block-end: 0.375rem;"
        >
          Affected Lab Locations *
        </p>
        <div
          style="display: flex; flex-direction: column; gap: 0.375rem;"
        >
          <label
            style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;"
          >
            <input
              checked=""
              type="checkbox"
            />
            <span>
              loc-001
            </span>
          </label>
          <label
            style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;"
          >
            <input
              checked=""
              type="checkbox"
            />
            <span>
              loc-002
            </span>
          </label>
        </div>
      </div>
      <div
        style="margin-block-end: 1rem;"
      >
        <label
          for="activation-reason"
          style="display: block; font-weight: 600; margin-block-end: 0.375rem;"
        >
          Activation Reason *
        </label>
        <textarea
          id="activation-reason"
          placeholder="e.g. "WHO outbreak alert", "Provincial directive #12""
          rows="3"
          style="width: 100%; padding: 0.5rem 0.75rem; border-radius: 6px; border: 1px solid rgb(209, 213, 219); font-size: 0.9375rem; resize: vertical; box-sizing: border-box;"
        />
      </div>
      <div
        style="margin-block-end: 1.5rem;"
      >
        <label
          for="surge-multiplier"
          style="display: block; font-weight: 600; margin-block-end: 0.375rem;"
        >
          Surge Inventory Multiplier
        </label>
        <div
          style="display: flex; align-items: center; gap: 0.75rem;"
        >
          <input
            id="surge-multiplier"
            max="10"
            min="1.5"
            step="0.5"
            style="width: 80px; padding: 0.5rem 0.75rem; border-radius: 6px; border: 1px solid rgb(209, 213, 219); font-size: 0.9375rem;"
            type="number"
            value="3"
          />
          <span
            style="color: rgb(107, 114, 128); font-size: 0.875rem;"
          >
            × normal consumption rate (range: 1.5× – 10×, default 3×)
          </span>
        </div>
      </div>
      <div
        style="display: flex; gap: 0.75rem; justify-content: flex-end;"
      >
        <button
          style="padding: 0.5rem 1.25rem; border-radius: 6px; border: 1px solid rgb(209, 213, 219); cursor: pointer; background-color: rgb(255, 255, 255);"
          type="button"
        >
          Cancel
        </button>
        <button
          style="padding: 0.5rem 1.25rem; border-radius: 6px; background-color: rgb(220, 38, 38); color: rgb(255, 255, 255); cursor: pointer; font-weight: 600;"
          type="button"
        >
          Review & Confirm
        </button>
      </div>
    </div>
  </div>
</div>
`;

