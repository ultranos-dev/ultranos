// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`FlagButton RTL snapshots > renders in LTR 1`] = `
<div>
  <button
    aria-label="Flag"
    class="text-xs text-muted-foreground hover:text-amber-600"
    title="Flag"
    type="button"
  >
    <svg
      fill="none"
      height="14"
      stroke="currentColor"
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      viewBox="0 0 24 24"
      width="14"
    >
      <path
        d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"
      />
      <line
        x1="4"
        x2="4"
        y1="22"
        y2="15"
      />
    </svg>
  </button>
</div>
`;

