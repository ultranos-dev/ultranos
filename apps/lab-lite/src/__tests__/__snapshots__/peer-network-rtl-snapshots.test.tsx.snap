exports[`PostFeed RTL snapshots > renders empty state in LTR 1`] = `
<div>
  <div
    class="flex flex-col gap-4"
  >
    <div
      class="flex flex-wrap items-center gap-2"
    >
      <select
        aria-label="Filter by status"
        class="rounded-lg border border-border px-3 py-1.5 text-sm"
      >
        <option
          value="all"
        >
          All
        </option>
        <option
          value="active"
        >
          Active
        </option>
        <option
          value="resolved"
        >
          Resolved
        </option>
        <option
          value="flagged"
        >
          Flagged
        </option>
      </select>
      <select
        aria-label="Filter by category"
        class="rounded-lg border border-border px-3 py-1.5 text-sm"
      >
        <option
          value=""
        >
          All Categories
        </option>
        <option
          value="hematology"
        >
          Hematology
        </option>
        <option
          value="chemistry"
        >
          categories.chemistry
        </option>
        <option
          value="microbiology"
        >
          categories.microbiology
        </option>
        <option
          value="urinalysis"
        >
          categories.urinalysis
        </option>
        <option
          value="immunology"
        >
          categories.immunology
        </option>
        <option
          value="parasitology"
        >
          categories.parasitology
        </option>
        <option
          value="blood_bank"
        >
          categories.blood_bank
        </option>
        <option
          value="other"
        >
          categories.other
        </option>
      </select>
      <input
        class="rounded-lg border border-border px-3 py-1.5 text-sm"
        placeholder="Filter by tag"
        type="text"
        value=""
      />
      <button
        class="ms-auto rounded-lg bg-primary-600 px-4 py-1.5 text-sm font-medium text-white hover:bg-primary-700"
        type="button"
      >
        Ask Question
      </button>
    </div>
    <div
      data-testid="empty-state"
    >
      No posts yet
    </div>
  </div>
</div>
`;

