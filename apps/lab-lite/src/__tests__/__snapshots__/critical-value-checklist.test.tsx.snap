            data-testid="critical-badge-Potassium"
          >
            Potassium
             — 
            HIGH
             (&gt; 6.5 mEq/L)
          </span>
        </div>
      </div>
      <div
        class="px-4 py-3 space-y-2 max-h-72 overflow-y-auto"
      >
        <label
          class="flex items-start gap-3 cursor-pointer group"
          data-testid="checklist-item-qc-passed-today"
        >
          <span
            class="relative mt-0.5 shrink-0"
          >
            <input
              aria-label="QC passed today for this analyte"
              checked=""
