              >
                <circle
                  cx="12"
                  cy="12"
                  r="10"
                />
                <path
                  d="m9 12 2 2 4-4"
                />
              </svg>
            </span>
          </span>
          <span
            class="flex-1 min-w-0"
          >
            <span
              class="text-sm text-foreground "
            >
              QC passed today for this analyte
            </span>
            <span
