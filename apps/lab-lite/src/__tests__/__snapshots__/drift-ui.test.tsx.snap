exports[`WestgardHistoryView > RTL snapshots > WestgardHistoryView renders correctly in LTR 1`] = `
<div>
  <div
    class="space-y-6"
  >
    <div
      class="overflow-x-auto rounded-lg border border-neutral-200 bg-white"
    >
      <table
        aria-label="QC Run History"
        class="w-full text-sm"
      >
        <thead
          class="bg-neutral-50 text-xs uppercase tracking-wide text-neutral-500"
        >
          <tr>
            <th
              class="px-3 py-2.5 text-start"
              scope="col"
            >
              Run Date
            </th>
            <th
              class="px-3 py-2.5 text-start"
              scope="col"
            >
              Control Level
            </th>
            <th
              class="px-3 py-2.5 text-end"
              scope="col"
            >
              Target Mean
            </th>
            <th
              class="px-3 py-2.5 text-end"
              scope="col"
            >
              Target SD
            </th>
            <th
              class="px-3 py-2.5 text-end"
              scope="col"
            >
              Observed Value
            </th>
            <th
              class="px-3 py-2.5 text-end"
              scope="col"
            >
              Deviation (SD)
            </th>
            <th
              class="px-3 py-2.5 text-start"
              scope="col"
            >
              Status
            </th>
          </tr>
        </thead>
        <tbody
          class="divide-y divide-neutral-100"
        >
          <tr
            class=""
          >
            <td
              class="px-3 py-2.5 text-neutral-900"
            >
              5/31/2026
            </td>
            <td
              class="px-3 py-2.5 text-neutral-600"
            >
              LEVEL_2
            </td>
            <td
              class="px-3 py-2.5 text-end tabular-nums text-neutral-700"
            >
              100.00
            </td>
            <td
              class="px-3 py-2.5 text-end tabular-nums text-neutral-700"
            >
              5.00
            </td>
            <td
              class="px-3 py-2.5 text-end tabular-nums font-medium text-neutral-900"
            >
              100.50
            </td>
            <td
              class="px-3 py-2.5 text-end tabular-nums text-neutral-600"
            >
              +
              0.10
               SD
            </td>
            <td
              class="px-3 py-2.5"
            >
              <span
                class="inline-flex items-center gap-1 rounded px-1.5 py-0.5 text-xs font-semibold bg-green-100 text-green-700"
              >
                PASS
              </span>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>
`;

