exports[`WestgardHistoryView > RTL snapshots > DriftAlertBanner renders correctly in LTR 1`] = `
<div>
  <div
    aria-atomic="true"
    aria-live="assertive"
    class="rounded-lg border p-3 bg-red-50 border-red-300"
    data-severity="REJECT"
    data-testid="drift-alert-banner"
    role="alert"
  >
    <div
      class="flex items-start gap-3"
    >
      <div
        aria-hidden="true"
        class="mt-0.5 shrink-0 text-red-500"
      >
        <svg
          class="h-5 w-5"
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path
            clip-rule="evenodd"
            d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z"
            fill-rule="evenodd"
          />
        </svg>
      </div>
      <div
        class="min-w-0 flex-1"
      >
        <p
          class="text-sm font-semibold text-red-800"
        >
          QC Out of Control
        </p>
        <p
          class="mt-0.5 text-sm text-red-800"
        >
          REJECT: latest value (116.00) exceeds ±3SD limit. Stop testing and recalibrate.
        </p>
      </div>
      <div
        class="flex shrink-0 flex-col gap-1.5 sm:flex-row"
      >
        <button
          aria-label="Acknowledge Alert"
          class="rounded px-2.5 py-1 text-xs font-medium bg-red-100 hover:bg-red-200 text-red-800 transition-colors"
          type="button"
        >
          Acknowledge
        </button>
        <button
          aria-label="View QC History"
          class="rounded px-2.5 py-1 text-xs font-medium bg-red-100 hover:bg-red-200 text-red-800 transition-colors"
          type="button"
        >
          View QC History
        </button>
      </div>
    </div>
  </div>
</div>
`;

