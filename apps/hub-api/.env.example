# =============================================================================
# Hub API Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or any file containing real secrets.

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWT_JWK={"kty":"RSA","n":"...","e":"AQAB"}

# --- Field-Level Encryption (Story 7.3) ---
# Two separate 256-bit keys in hex format (64 hex characters each).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# FIELD_ENCRYPTION_KEY: AES-256-GCM key for encrypting/decrypting PHI columns
#   (diagnosis, reason_code, dosage_instruction, interaction_override, etc.)
#
# FIELD_ENCRYPTION_HMAC_KEY: HMAC-SHA256 key for blind index generation
#   (national_id lookups without decrypting stored values)
#
# IMPORTANT:
#   - These keys MUST be different from each other.
#   - Store in Supabase Secrets (supabase secrets set) or cloud secret manager.
#   - Losing these keys means permanent loss of all encrypted PHI data.
#   - Key rotation: encrypted values use "v1:" prefix to support future rotation.
#   - Back up keys securely in a separate system from the database.
FIELD_ENCRYPTION_KEY=
FIELD_ENCRYPTION_HMAC_KEY=

# --- Redis (Story 23.0) ---
# Required in production. Use rediss:// for TLS. Example: rediss://default:password@host:6380
# In development, redis:// (no TLS) is accepted. In production, only rediss:// is allowed.
REDIS_URL=

# --- Cron Jobs (Epic 22) ---
# Secret token for authenticating cron endpoint invocations.
# Used by /api/cron/license-expiry and /api/cron/anomaly-detection.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# --- CORS (Story 21.4) ---
# Comma-separated list of allowed origins for cross-origin requests.
# In development, localhost origins (3000-3003) are allowed by default.
# CORS_ALLOWED_ORIGINS=https://opd.ultranos.app,https://pharmacy.ultranos.app,https://lab.ultranos.app,https://admin.ultranos.app

# --- Billing (Story 27.8) ---
# Provider selection: "stripe" (default) or "tap"
BILLING_PROVIDER=stripe

# Stripe configuration (required when BILLING_PROVIDER=stripe)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# JSON mapping module codes to Stripe price IDs
STRIPE_PRICE_MAP={"OPD_LITE":"price_xxx","PHARMACY_LITE":"price_yyy","LAB_LITE":"price_zzz"}

# Tap Payments configuration (required when BILLING_PROVIDER=tap)
# TAP_API_KEY=sk_test_...
# TAP_WEBHOOK_SECRET=whsec_...

# --- Metrics & Alerting (Story 23.1) ---
# Bearer token for authenticating Prometheus scrape requests to /api/metrics.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
METRICS_BEARER_TOKEN=

# Webhook URL for alert delivery (Slack, PagerDuty, generic).
# POST JSON payload: { severity, title, description, metric, currentValue, threshold, timestamp }
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# --- AI Clinical Scribe (Story 24.1) ---
# OpenAI-compatible API endpoint for SOAP note parsing.
# Supports OpenAI, Azure OpenAI, or any compatible local LLM.
AI_SCRIBE_API_URL=https://api.openai.com/v1
AI_SCRIBE_API_KEY=sk-...
# AI_SCRIBE_MODEL=gpt-4o

# --- TTS / Empathy Translation Engine (Story 24.2) ---
# Cloud TTS API endpoint for audio synthesis (Google Cloud TTS, Azure Speech, or equivalent).
# Output: MP3, 16kHz, mono. Timeout: 10 seconds.
TTS_API_URL=
TTS_API_KEY=

# LLM endpoint for dialect translation (can be same as AI_SCRIBE_API_URL if using the same provider).
# Translates clinical instructions into conversational dialect text before TTS synthesis.
# Supported dialects: AR_LEVANTINE (Levantine Arabic), AR_GULF (Gulf Arabic), DARI (Afghan Dari), EN (English).
AI_DIALECT_TRANSLATION_API_URL=
AI_DIALECT_TRANSLATION_API_KEY=
